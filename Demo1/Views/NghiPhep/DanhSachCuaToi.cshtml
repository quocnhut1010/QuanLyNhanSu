@model IEnumerable<Demo1.Models.QUANLYNGHIPHEP>

@{
    ViewBag.Title = "Don nghi phep cua toi";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";

    var message = ViewBag.Message as string;

    Func<bool?, string> statusText = status =>
    {
        if (!status.HasValue)
        {
            return "Dang cho duyet";
        }

        return status.Value ? "Da duyet" : "Tu choi";
    };

    Func<bool?, string> statusClass = status =>
    {
        if (!status.HasValue)
        {
            return "badge bg-warning text-dark";
        }

        return status.Value ? "badge bg-success" : "badge bg-danger";
    };
}

<h2 class="text-center text-primary">Don nghi phep cua toi</h2>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success">@message</div>
}

<p>
    @Html.ActionLink("Gui don nghi phep", "TaoMoi", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Loai nghi</th>
            <th>Ngay bat dau</th>
            <th>Ngay ket thuc</th>
            <th>So ngay nghi</th>
            <th>Trang thai</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.LOAINGHI</td>
            <td>@(item.NGAYBATDAU.HasValue ? item.NGAYBATDAU.Value.ToString("dd/MM/yyyy") : "")</td>
            <td>@(item.NGAYKETTHUC.HasValue ? item.NGAYKETTHUC.Value.ToString("dd/MM/yyyy") : "")</td>
            <td>@(item.SONGAYNGHI ?? 0)</td>
            <td><span class="@statusClass(item.TRANGTHAI)">@statusText(item.TRANGTHAI)</span></td>
            <td>@Html.ActionLink("Chi tiet", "ChiTiet", new { id = item.MANP }, new { @class = "btn btn-link" })</td>
        </tr>
    }
    </tbody>
</table>
