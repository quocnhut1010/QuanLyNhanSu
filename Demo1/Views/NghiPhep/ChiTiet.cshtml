@model Demo1.Models.QUANLYNGHIPHEP

@{
    var isAdmin = Session["TaikhoanAdmin"] != null;
    Layout = isAdmin ? "~/Views/Shared/_LayoutAdmin1.cshtml" : "~/Views/Shared/_LayoutUser.cshtml";
    ViewBag.Title = "Chi tiet nghi phep";

    Func<bool?, string> statusText = status =>
    {
        if (!status.HasValue)
        {
            return "Dang cho duyet";
        }

        return status.Value ? "Da duyet" : "Tu choi";
    };

    Func<bool?, string> statusClass = status =>
    {
        if (!status.HasValue)
        {
            return "badge bg-warning text-dark";
        }

        return status.Value ? "badge bg-success" : "badge bg-danger";
    };
}

<div class="container">
    <h3 class="text-center text-danger">Chi tiet don nghi phep</h3>
    <hr />
    <table class="table table-bordered">
        <tr>
            <th>Ma nhan vien</th>
            <td>@Model.MSNV</td>
        </tr>
        <tr>
            <th>Ho ten</th>
            <td>@(Model.NHANVIEN != null ? Model.NHANVIEN.HOTEN : "")</td>
        </tr>
        <tr>
            <th>Loai nghi</th>
            <td>@Model.LOAINGHI</td>
        </tr>
        <tr>
            <th>Ngay bat dau</th>
            <td>@(Model.NGAYBATDAU.HasValue ? Model.NGAYBATDAU.Value.ToString("dd/MM/yyyy") : "")</td>
        </tr>
        <tr>
            <th>Ngay ket thuc</th>
            <td>@(Model.NGAYKETTHUC.HasValue ? Model.NGAYKETTHUC.Value.ToString("dd/MM/yyyy") : "")</td>
        </tr>
        <tr>
            <th>So ngay nghi</th>
            <td>@(Model.SONGAYNGHI ?? 0)</td>
        </tr>
        <tr>
            <th>Trang thai</th>
            <td><span class="@statusClass(Model.TRANGTHAI)">@statusText(Model.TRANGTHAI)</span></td>
        </tr>
    </table>

    <div class="mb-3">
        @if (isAdmin && !Model.TRANGTHAI.HasValue)
        {
            @Html.ActionLink("Duyet", "DuyetNghiPhep", new { id = Model.MANP }, new { @class = "btn btn-success" })
            <span>&nbsp;</span>
            @Html.ActionLink("Tu choi", "TuChoiNghiPhep", new { id = Model.MANP }, new { @class = "btn btn-danger" })
        }
    </div>

    <p>
        @if (isAdmin)
        {
            @Html.ActionLink("Tro lai danh sach", "Index", null, new { @class = "btn btn-secondary" })
        }
        else
        {
            @Html.ActionLink("Tro lai danh sach", "DanhSachCuaToi", "NghiPhep", null, new { @class = "btn btn-secondary" })
        }
    </p>
</div>

