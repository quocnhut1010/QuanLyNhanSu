@model Demo1.Models.NHANVIEN

@{
    ViewBag.Title = "ThongTin";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";

    Func<string, bool> isBase64String = value =>
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var trimmed = value.Trim();
        if (trimmed.Length % 4 != 0)
        {
            return false;
        }

        try
        {
            Convert.FromBase64String(trimmed);
            return true;
        }
        catch
        {
            return false;
        }
    };

    Func<string, string> buildImageSrc = value =>
    {
        if (string.IsNullOrEmpty(value))
        {
            return "data:image/svg+xml;base64,";
        }

        return isBase64String(value)
            ? string.Format("data:image/jpeg;base64,{0}", value)
            : Url.Content("~/img/" + value);
    };

    var imageSrc = buildImageSrc(Model.HINHANH);
}

<style>
    .cv-container {
        max-width: 800px;
        margin: 20px auto;
        padding: 20px;
        border: 1px solid #ccc;
        border-radius: 5px;
        background-color: #f9f9f9;
    }

    .cv-header {
        text-align: center;
    }

    .cv-photo {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        margin: 20px auto;
        display: block;
        object-fit: cover;
    }

    .cv-section {
        margin-bottom: 20px;
    }

        .cv-section h3 {
            margin-bottom: 10px;
        }

        .cv-section dl {
            display: grid;
            grid-template-columns: auto auto;
            gap: 10px;
        }

            .cv-section dl dt {
                font-weight: bold;
            }

            .cv-section dl dd {
                margin-left: 0;
            }

    .cv-actions {
        text-align: center;
        margin-top: 20px;
    }

        .cv-actions .btn {
            display: inline-block;
            padding: 8px 16px;
            margin: 0 5px;
            border-radius: 4px;
            text-decoration: none;
        }

    .alert-success {
        padding: 10px 16px;
        border-radius: 4px;
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
        margin-bottom: 15px;
        text-align: center;
    }
</style>

<div class="cv-container">
    @if (!string.IsNullOrEmpty(ViewBag.Message as string))
    {
        <div class="alert-success">@ViewBag.Message</div>
    }
    <div class="cv-header">
        <h1>Ho so nhan vien</h1>
        <img class="cv-photo" src="@imageSrc" alt="Hinh anh nhan vien" />
    </div>
    <div class="cv-section">
        <h3>Thong tin ca nhan</h3>
        <dl>
            <dt>Ma nhan vien:</dt>
            <dd>@Model.MSNV</dd>
            <dt>Ho va ten:</dt>
            <dd>@Model.HOTEN</dd>
            <dt>Gioi tinh:</dt>
            <dd>@Model.GIOITINH</dd>
            <dt>Ngay sinh:</dt>
            <dd>@Model.NGAYSINH</dd>
            <dt>Que quan:</dt>
            <dd>@Model.QUEQUAN</dd>
            <dt>Tam tru:</dt>
            <dd>@Model.TAMTRU</dd>
            <dt>So dien thoai:</dt>
            <dd>@Model.SDT</dd>
            <dt>Email:</dt>
            <dd>@Model.EMAIL</dd>
            <dt>Dan toc:</dt>
            <dd>@Model.DANTOC</dd>
            <dt>Hoc van:</dt>
            <dd>@Model.HOCVAN</dd>
            <dt>CCCD:</dt>
            <dd>@Model.CCCD</dd>
        </dl>
    </div>
    <div class="cv-actions">
        @Html.ActionLink("Chinh sua thong tin", "ChinhSua", null, new { @class = "btn btn-primary" })
        @*@Html.ActionLink("Don nghi phep", "DanhSachCuaToi", "NghiPhep", null, new { @class = "btn btn-secondary" })*@
    </div>
</div>
