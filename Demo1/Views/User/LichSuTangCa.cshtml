@model IEnumerable<Demo1.Models.TANGCA>

@{
    ViewBag.Title = "LichSuTangCa";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
    var message = ViewBag.OvertimeMessage as string;
}

<h2 class="text-center text-danger">Lich su tang ca</h2>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success">@message</div>
}

<p>
    @Html.ActionLink("Gui yeu cau tang ca", "TaoYeuCauTangCa", null, new { @class = "btn btn-primary" })
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Ho ten</th>
            <th>Ngay</th>
            <th>Gio bat dau</th>
            <th>Gio ket thuc</th>
            <th>So gio</th>
            <th>Trang thai</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        var statusText = item.TRANGTHAI.HasValue ? (item.TRANGTHAI.Value ? "Da duyet" : "Tu choi") : "Dang cho duyet";
        var statusClass = item.TRANGTHAI.HasValue ? (item.TRANGTHAI.Value ? "badge bg-success" : "badge bg-danger") : "badge bg-warning text-dark";
        <tr>
            <td>@(item.NHANVIEN != null ? item.NHANVIEN.HOTEN : string.Empty)</td>
            <td>@(item.NGAY.HasValue ? item.NGAY.Value.ToString("dd/MM/yyyy") : string.Empty)</td>
            <td>@(item.GIOBATDAU.HasValue ? DateTime.Today.Add(item.GIOBATDAU.Value).ToString("HH:mm") : string.Empty)</td>
            <td>@(item.GIOKETTHUC.HasValue ? DateTime.Today.Add(item.GIOKETTHUC.Value).ToString("HH:mm") : string.Empty)</td>
            <td>@(item.SOGIO ?? 0)</td>
            <td><span class="@statusClass">@statusText</span></td>
        </tr>
    }
    </tbody>
</table>
